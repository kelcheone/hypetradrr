# Safety: the application refuses to start if this is false.
PAPER_ONLY=true

POSTGRES_DB=paper
POSTGRES_USER=paper
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql://paper:change-this-database-password@db:5432/paper

SYMBOL=BTC
STARTING_BALANCE=10000
LEVERAGES=5,10,15,20,25,30,35,40
LOOKBACK_MINUTES=5
DIP_TRIGGER_PCT=0.25
RALLY_TRIGGER_PCT=0.25
RECOVERY_TRIGGER_PCT=0.05
REVERSAL_TRIGGER_PCT=0.05
TAKE_PROFIT_PCT=0.20
STOP_LOSS_PCT=0.10
RISK_PER_TRADE_PCT=1.0
FIXED_MARGIN_PER_TRADE=2000
MAX_TRADES_PER_DAY=10
MAX_DAILY_LOSS_PCT=3
MAX_TOTAL_DRAWDOWN_PCT=30
COOLDOWN_SECONDS=300
MARKET_DATA_STALE_SECONDS=10
SLIPPAGE_BPS=1
TAKER_FEE_BPS=4.5
EXPERIMENT_DURATION_DAYS=7
ENABLE_LONGS=true
ENABLE_SHORTS=true
FUNDING_MODE=DISABLED

# Multi-strategy lab v2. These values are frozen in each experiment record.
LAB_STARTING_BALANCE=10000
LAB_DURATION_DAYS=30
PERP_TAKER_FEE_BPS=4.5
PERP_MAKER_FEE_BPS=1.5
SPOT_TAKER_FEE_BPS=7
SPOT_MAKER_FEE_BPS=4
LAB_SLIPPAGE_BPS=1
LAB_MAX_GROSS_MULTIPLE=2
LAB_MAX_DAILY_LOSS_PCT=2
LAB_MAX_DRAWDOWN_PCT=15

REPORTS_DIR=/app/reports
GIT_COMMIT=replace-with-output-of-git-rev-parse-HEAD
HOST=0.0.0.0
PORT=8000
